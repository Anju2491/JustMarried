#l21nus-clis{
  padding:0px!important;
  margin:0;
  z-index: 999;
  display:block!important;
  box-sizing:border-box;
  position: relative;
}
#l21nus-clis ul{
  margin:0;
  list-style-type:none;
  cursor:move;
  display: flex;
  align-items: center;
  flex-direction: row;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
}
#l21nus-clis li{
  position:relative;
  display:flex!important;
  width:40px;
  height:40px;
  max-width: 45px;
}
#l21nus-login form,
#l21nus-clis li{
  background:var(--orange-fiche);
}
#l21nus-clis li:not(:last-child){
  margin-bottom:10px;
}
.l21nus-logged{
  width:50px!important;
  height:50px!important;
  box-sizing:content-box;
  padding:1px!important
}
#l21nus-clis a{
  display:block;
  overflow:hidden;
  width:100%;
  height:100%;
  background-color:lightgray;
}
.l21nus-logged a{
  cursor:default;
}
#l21nus-clis img{
  width:100%;
}
.l21nus-loading::before{
  content:' ';
  width:40px;
  height:40px;
  position:absolute;
  background-position:50%;
  background-image:url("data:image/svg+xml;utf8,%3Csvg%20width%3D%22120%22%20height%3D%2230%22%20viewBox%3D%220%200%20120%2030%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20fill%3D%22%23c0c0c0%22%3E%3Ccircle%20cx%3D%2215%22%20cy%3D%2215%22%20r%3D%2215%22%3E%3Canimate%20attributeName%3D%22r%22%20from%3D%2215%22%20to%3D%2215%22%20begin%3D%220s%22%20dur%3D%220.8s%22%20values%3D%2215%3B9%3B15%22%20calcMode%3D%22linear%22%20repeatCount%3D%22indefinite%22%20/%3E%20%3Canimate%20attributeName%3D%22fill-opacity%22%20from%3D%221%22%20to%3D%221%22%20begin%3D%220s%22%20dur%3D%220.8s%22%20values%3D%221%3B.5%3B1%22%20calcMode%3D%22linear%22%20repeatCount%3D%22indefinite%22%20/%3E%3C/circle%3E%3Ccircle%20cx%3D%2260%22%20cy%3D%2215%22%20r%3D%229%22%20fill-opacity%3D%220.3%22%3E%3Canimate%20attributeName%3D%22r%22%20from%3D%229%22%20to%3D%229%22%20begin%3D%220s%22%20dur%3D%220.8s%22%20values%3D%229%3B15%3B9%22%20calcMode%3D%22linear%22%20repeatCount%3D%22indefinite%22%20/%3E%3Canimate%20attributeName%3D%22fill-opacity%22%20from%3D%220.5%22%20to%3D%220.5%22%20begin%3D%220s%22%20dur%3D%220.8s%22%20values%3D%22.5%3B1%3B.5%22%20calcMode%3D%22linear%22%20repeatCount%3D%22indefinite%22%20/%3E%3C/circle%3E%3Ccircle%20cx%3D%22105%22%20cy%3D%2215%22%20r%3D%2215%22%3E%3Canimate%20attributeName%3D%22r%22%20from%3D%2215%22%20to%3D%2215%22%20begin%3D%220s%22%20dur%3D%220.8s%22%20values%3D%2215%3B9%3B15%22%20calcMode%3D%22linear%22%20repeatCount%3D%22indefinite%22%20/%3E%3Canimate%20attributeName%3D%22fill-opacity%22%20from%3D%221%22%20to%3D%221%22%20begin%3D%220s%22%20dur%3D%220.8s%22%20values%3D%221%3B.5%3B1%22%20calcMode%3D%22linear%22%20repeatCount%3D%22indefinite%22%20/%3E%3C/circle%3E%3C/svg%3E%0A");
  background-repeat:no-repeat;
  background-size:50%;
  background-color:rgba(0,0,0,0.25);
  right:0;
  top:0;
}
.l21nus-loading::before,
#l21nus-clis a,
#l21nus-clis li{
  border-radius:4px;
}
#l21nus-clis li:hover .l21nus-cdel{
  display:flex;
}
.l21nus-cdel{
  display:none;
  position:absolute;
  z-index:10;
  background:black;
  border-radius:100%;
  align-items:center;
  justify-content:center;
  font-family:arial;
  color:white;
  bottom:-2px;
  right:-2px;
  width:12px;
  height:12px;
  font-size:10px;
  line-height:10px;
  cursor:pointer;
}
.l21nus-logged .l21nus-cdel{
  bottom:-4px!important;
  right:-4px!important;
}


