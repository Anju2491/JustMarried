}
#l21nus-login input[type="submit"]{
  position:absolute!important;
  right:0!important;
  height:100%!important;
  width:20%!important;
  padding:0px!important;
  background-image:url("data:image/svg+xml;utf8,%3Csvg%20id%3D%22light%22%20enable-background%3D%22new%200%200%2024%2024%22%20height%3D%22512%22%20viewBox%3D%220%200%2024%2024%22%20width%3D%22512%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%3E%3Cpath%20fill%3D%22%23fff%22%20d%3D%22m15.5%2012.5h-15c-.276%200-.5-.224-.5-.5s.224-.5.5-.5h15c.276%200%20.5.224.5.5s-.224.5-.5.5z%22%2F%3E%3C%2Fg%3E%3Cg%3E%3Cpath%20fill%3D%22%23fff%22%20d%3D%22m11.5%2016.5c-.128%200-.256-.049-.354-.146-.195-.195-.195-.512%200-.707l3.647-3.647-3.646-3.646c-.195-.195-.195-.512%200-.707s.512-.195.707%200l4%204c.195.195.195.512%200%20.707l-4%204c-.098.097-.226.146-.354.146z%22%2F%3E%3C%2Fg%3E%3Cg%3E%3Cpath%20fill%3D%22%23fff%22%20d%3D%22m12%2023c-4.655%200-8.823-2.947-10.372-7.333-.092-.261.045-.546.305-.638.261-.09.546.045.638.305%201.408%203.987%205.197%206.666%209.429%206.666%205.514%200%2010-4.486%2010-10s-4.486-10-10-10c-4.232%200-8.021%202.679-9.428%206.667-.092.26-.378.395-.638.305-.26-.092-.397-.377-.305-.638%201.548-4.387%205.716-7.334%2010.371-7.334%206.065%200%2011%204.935%2011%2011s-4.935%2011-11%2011z%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E"); 
  background-size:55%;
