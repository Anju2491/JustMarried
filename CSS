/*** CSS FORUM TEST ***/
/********************************************************************** Variables couleurs */
:root
{
  --blanc: #fff;
  --rose-pale: #f1ced0;
  --rose: #e2bebe;
  --rose-fonce: #846d70;
  --marron: #633a33;  
  --marron-fonce: #372225;
  --groupe1: #ffbfa0;
  --groupe2: #ff874d;
  --groupe3: #b78af9;
  --groupe4: #942dff;
  --blue-fonce-fiche: #02012f;
  --orange-fiche:#ff8e38;
  --blue-pale-fi:#dacee2;
  --violet-clair:#d6d6ff;
}

/**** Police */
@font-face {
  font-family: "snowman";
  src:url("https://dl.dropbox.com/scl/fi/49qjz0ogczcfxwfe2mlhg/Snowman.otf?rlkey=d4trx2l2wqcllp8398cwa4maz&dl=0")format("truetype");
  font-weight: 200;
  font-style: normal;
}

@font-face {
  font-family: "lequire";
  src:url("https://dl.dropbox.com/scl/fi/ghcvx1rfpxybw9n56hjfl/LEQUIRE.OTF?rlkey=aqyvdofrcw23f2goekd0knoa1&st=o5mp1vhk&dl=0")format("OpenType");
  font-style: normal;
  }

/** Switcheroo **/
#l21nus-clis *{
  user-select:none;
  -webkit-user-drag:none;
}
#l21nus-login a, .l21nus-moving .l21nus-cdel{
  display:none!important;
}
#l21nus-login{
  position:absolute;
  top:0;
  left:100%;
  width:150px;
  margin-left:-5px;
  overflow:hidden;
  box-shadow:4px 4px 5px rgba(0,0,0,.15);
}
#l21nus-login form{
  display:flex;
  flex-direction:column;
  justify-content:center;
  position:relative;
  border-radius:5px;
  padding:1px;
}
#l21nus-login input[type="submit"],
#l21nus-login input[type="text"],
#l21nus-login input[type="password"]{
  margin:0px!important;
  outline:0!important;
  font-size:10px!important;
  line-height:10px!important;
  border-radius:0px!important;
  font-family:arial!important;
  text-align:left!important;
  text-transform:none!important;
  box-sizing:border-box;
}
#l21nus-login input[type="text"]{
  border-top-left-radius:4px!important;
}
#l21nus-login input[type="password"]{
  border-top:1px solid rgba(0,0,0,.1)!important;
  border-bottom-left-radius:4px!important;
}
#l21nus-login input[type="text"],
#l21nus-login input[type="password"]{
  height:auto!important;
  width:80%!important;
  background:#fff!important;
  padding:5px!important;
}
.l21nus-add a{  
  background-color:transparent!important;
  font-size:24px;
  font-family:"times new roman";
  color:#d5d6fe;
}
.l21nus-add a:not(.l21nus-loading)::before{
  content:'+';
  display:flex;
  width:100%;
  height:100%;
  justify-content:center;
  align-items:center;
      color: var(--fond-connect);
}
#l21nus-clis li.l21nus-moving{
  z-index: 999;
}
li.l21nus-moving .l21nus-drag,
#l21nus-clis li:hover .l21nus-drag{
  width:10px!important;
}
.l21nus-moving{
  opacity:.5;
}
